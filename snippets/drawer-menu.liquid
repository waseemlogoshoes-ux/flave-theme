{%- assign drawer_position = 'right' -%}
{% if logo_alignment == 'center' %}
  {%- assign drawer_position = 'left' -%}
{% endif %}

<!-- FLAVE Nav Overlay -->
<div id="FlaveNavOverlay" class="flave-nav-overlay" onclick="flaveCloseNav()"></div>

<!-- FLAVE Side Navigation Drawer -->
<div id="NavDrawer" class="flave-nav-drawer flave-nav-drawer--{{ drawer_position }}" role="dialog" aria-label="Navigation" aria-modal="true">

  <!-- Drawer Header -->
  <div class="flave-nav-drawer__header">
    <div class="flave-nav-drawer__logo">
      {%- if settings.logo -%}
        <img src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" width="120" height="auto">
      {%- else -%}
        <span class="flave-nav-drawer__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </div>
    <button type="button" class="flave-nav-drawer__close js-drawer-close" aria-label="Close menu" onclick="flaveCloseNav()">
      <svg width="20" height="20" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/>
      </svg>
    </button>
  </div>

  <!-- Main Nav Links -->
  <div class="flave-nav-drawer__scrollable">
    <nav class="flave-nav-drawer__nav" role="navigation" aria-label="Primary">
      <ul class="flave-nav-list">
        {%- for link in main_menu.links -%}
          {%- assign has_dropdown = false -%}
          {%- if link.links != blank -%}
            {%- assign has_dropdown = true -%}
          {%- endif -%}
          {%- assign child_list_handle = link.url | handleize | append: forloop.index -%}

          <li class="flave-nav-list__item flave-nav-reveal" style="--delay: {{ forloop.index | times: 0.06 }}s">
            {%- if has_dropdown -%}
              <div class="flave-nav-list__has-children">
                <a href="{{ link.url }}"
                  class="flave-nav-list__link{% if link.active %} is-active{% endif %}">
                  {{ link.title }}
                </a>
                <button type="button"
                  class="flave-nav-list__toggle collapsible-trigger collapsible--auto-height{% if link.active or link.child_active %} is-open{% endif %}"
                  aria-controls="FlaveSublist-{{ child_list_handle }}"
                  aria-expanded="{% if link.active or link.child_active %}true{% else %}false{% endif %}">
                  <svg width="14" height="14" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flave-nav-list__chevron">
                    <path d="m16 24 16 16 16-16"/>
                  </svg>
                </button>
              </div>
              <div id="FlaveSublist-{{ child_list_handle }}"
                class="flave-nav-sublist collapsible-content collapsible-content--all{% if link.active or link.child_active %} is-open{% endif %}"
                {% if link.active or link.child_active %}style="height:auto;"{% endif %}>
                <div class="collapsible-content__inner">
                  <ul class="flave-nav-sublist__list">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}"
                          class="flave-nav-sublist__link{% if childlink.active %} is-active{% endif %}">
                          {{ childlink.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}"
                class="flave-nav-list__link{% if link.active %} is-active{% endif %}">
                {{ link.title }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Bottom section: Login + Instagram -->
    <div class="flave-nav-drawer__footer">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="flave-nav-drawer__account-link">
          <svg width="16" height="16" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="32" cy="20" r="12"/><path d="M8 56c0-13.255 10.745-24 24-24s24 10.745 24 24"/>
          </svg>
          {% if customer %}{{ customer.first_name | default: 'Account' }}{% else %}Log In{% endif %}
        </a>
      {%- endif -%}

      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="flave-nav-drawer__instagram-link">
          <svg width="16" height="16" viewBox="0 0 32 32" fill="currentColor">
            <path d="M16 3.094c4.206 0 4.7.019 6.363.094 1.538.069 2.369.325 2.925.544.738.287 1.262.625 1.813 1.175s.894 1.075 1.175 1.813c.212.556.475 1.387.544 2.925.075 1.662.094 2.156.094 6.363s-.019 4.7-.094 6.363c-.069 1.538-.325 2.369-.544 2.925-.288.738-.625 1.262-1.175 1.813s-1.075.894-1.813 1.175c-.556.212-1.387.475-2.925.544-1.663.075-2.156.094-6.363.094s-4.7-.019-6.363-.094c-1.537-.069-2.369-.325-2.925-.544-.737-.288-1.263-.625-1.813-1.175s-.894-1.075-1.175-1.813c-.212-.556-.475-1.387-.544-2.925-.075-1.663-.094-2.156-.094-6.363s.019-4.7.094-6.363c.069-1.537.325-2.369.544-2.925.287-.737.625-1.263 1.175-1.813s1.075-.894 1.813-1.175c.556-.212 1.388-.475 2.925-.544 1.662-.081 2.156-.094 6.363-.094zm0-2.838c-4.275 0-4.813.019-6.494.094-1.675.075-2.819.344-3.819.731-1.037.4-1.913.944-2.788 1.819S1.486 4.656 1.08 5.688c-.387 1-.656 2.144-.731 3.825C.274 11.188.256 11.726.256 16s.019 4.813.094 6.494c.075 1.675.344 2.819.731 3.825.4 1.038.944 1.913 1.819 2.788s1.756 1.413 2.788 1.819c1 .387 2.144.656 3.825.731S11.726 31.744 16 31.744s4.813-.019 6.494-.094c1.675-.075 2.819-.344 3.825-.731 1.038-.4 1.913-.944 2.788-1.819s1.413-1.756 1.819-2.788c.387-1 .656-2.144.731-3.825s.094-2.212.094-6.494-.019-4.813-.094-6.494c-.075-1.675-.344-2.819-.731-3.825-.4-1.038-.944-1.913-1.819-2.788s-1.756-1.413-2.788-1.819c-1-.387-2.144-.656-3.825-.731C20.812.275 20.275.256 16 .256z"/>
            <path d="M16 7.912a8.088 8.088 0 0 0 0 16.175c4.463 0 8.087-3.625 8.087-8.088S20.463 7.912 16 7.912zm0 13.338a5.25 5.25 0 1 1 0-10.5 5.25 5.25 0 0 1 0 10.5z"/>
            <circle cx="24.294" cy="7.594" r="1.887"/>
          </svg>
          Follow @flave
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
/* ── FLAVE NAV OVERLAY ── */
.flave-nav-overlay {
  position: fixed;
  inset: 0;
  background: rgba(44, 32, 23, 0.5);
  z-index: 9998;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.38s ease, visibility 0.38s ease;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}
.flave-nav-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

/* ── FLAVE NAV DRAWER ── */
.flave-nav-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 32vw;
  max-width: 460px;
  min-width: 280px;
  background: #faf6f0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  border-right: 1px solid #e0d5c5;
}
.flave-nav-drawer--left {
  left: 0;
  transform: translateX(-100%);
  border-right: 1px solid #e0d5c5;
  border-left: none;
  box-shadow: 6px 0 40px rgba(44,32,23,0.1);
}
.flave-nav-drawer--right {
  right: 0;
  transform: translateX(100%);
  border-left: 1px solid #e0d5c5;
  border-right: none;
  box-shadow: -6px 0 40px rgba(44,32,23,0.1);
}
.flave-nav-drawer.is-open {
  transform: translateX(0) !important;
}

/* ── DRAWER HEADER ── */
.flave-nav-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px 28px;
  border-bottom: 1px solid #e0d5c5;
  flex-shrink: 0;
}
.flave-nav-drawer__shop-name {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  letter-spacing: 0.18em;
  color: #6b2737;
  text-transform: uppercase;
}
.flave-nav-drawer__close {
  background: none;
  border: 0;
  cursor: pointer;
  color: #2c2017;
  padding: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.2s, transform 0.2s;
  border-radius: 50%;
}
.flave-nav-drawer__close:hover {
  color: #6b2737;
  transform: rotate(90deg);
}

/* ── NAV SCROLLABLE AREA ── */
.flave-nav-drawer__scrollable {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  -webkit-overflow-scrolling: touch;
}

/* ── NAV LIST ── */
.flave-nav-list {
  list-style: none;
  margin: 0;
  padding: 8px 0;
}
.flave-nav-list__item {
  border-bottom: 1px solid #ede5d8;
  opacity: 0;
  transform: translateX(-16px);
  animation: flaveNavReveal 0.45s cubic-bezier(0.16,1,0.3,1) forwards;
  animation-delay: var(--delay, 0s);
}
@keyframes flaveNavReveal {
  to { opacity: 1; transform: translateX(0); }
}
.flave-nav-list__has-children {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flave-nav-list__link {
  display: block;
  flex: 1;
  padding: 16px 28px;
  font-size: 13px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #2c2017;
  text-decoration: none;
  font-weight: 400;
  transition: color 0.2s;
}
.flave-nav-list__link:hover,
.flave-nav-list__link.is-active {
  color: #6b2737;
}
.flave-nav-list__toggle {
  background: none;
  border: 0;
  cursor: pointer;
  padding: 16px 20px 16px 8px;
  color: #2c2017;
  display: flex;
  align-items: center;
  transition: color 0.2s;
}
.flave-nav-list__chevron {
  transition: transform 0.3s ease;
}
.flave-nav-list__toggle.is-open .flave-nav-list__chevron {
  transform: rotate(180deg);
}
.flave-nav-list__toggle:hover {
  color: #6b2737;
}

/* ── SUBLIST ── */
.flave-nav-sublist {
  overflow: hidden;
}
.flave-nav-sublist__list {
  list-style: none;
  margin: 0;
  padding: 4px 0 8px 0;
  background: #f2ebe0;
}
.flave-nav-sublist__link {
  display: block;
  padding: 10px 40px;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #5c4a35;
  text-decoration: none;
  transition: color 0.2s, padding-left 0.2s;
}
.flave-nav-sublist__link:hover,
.flave-nav-sublist__link.is-active {
  color: #6b2737;
  padding-left: 48px;
}

/* ── DRAWER FOOTER ── */
.flave-nav-drawer__footer {
  margin-top: auto;
  padding: 20px 28px 28px;
  border-top: 1px solid #e0d5c5;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.flave-nav-drawer__account-link,
.flave-nav-drawer__instagram-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #5c4a35;
  text-decoration: none;
  transition: color 0.2s;
  border-bottom: 1px solid #ede5d8;
}
.flave-nav-drawer__instagram-link {
  border-bottom: none;
}
.flave-nav-drawer__account-link:hover,
.flave-nav-drawer__instagram-link:hover {
  color: #6b2737;
}

/* ── MOBILE ── */
@media (max-width: 768px) {
  .flave-nav-drawer {
    width: 88vw;
    max-width: 380px;
  }
  .flave-nav-list__link {
    padding: 15px 22px;
  }
  .flave-nav-drawer__header {
    padding: 20px 22px;
  }
  .flave-nav-drawer__footer {
    padding: 16px 22px 24px;
  }
}
</style>

<script>
(function() {
  'use strict';

  var drawer = document.getElementById('NavDrawer');
  var overlay = document.getElementById('FlaveNavOverlay');

  window.flaveOpenNav = function() {
    if (!drawer || !overlay) return;
    drawer.classList.add('is-open');
    overlay.classList.add('is-visible');
    document.body.style.overflow = 'hidden';
    document.body.classList.add('flave-nav-open');
  };

  window.flaveCloseNav = function() {
    if (!drawer || !overlay) return;
    drawer.classList.remove('is-open');
    overlay.classList.remove('is-visible');
    document.body.style.overflow = '';
    document.body.classList.remove('flave-nav-open');
  };

  // ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') flaveCloseNav();
  });

  // Hook existing hamburger buttons
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.js-drawer-open-nav, [data-drawer="NavDrawer"]');
    if (btn) {
      e.preventDefault();
      flaveOpenNav();
    }
    var closeBtn = e.target.closest('.js-drawer-close');
    if (closeBtn) {
      flaveCloseNav();
    }
  });

  // Collapsible submenus
  document.addEventListener('click', function(e) {
    var toggle = e.target.closest('.flave-nav-list__toggle');
    if (!toggle) return;
    var targetId = toggle.getAttribute('aria-controls');
    var target = document.getElementById(targetId);
    if (!target) return;
    var isOpen = toggle.classList.contains('is-open');
    if (isOpen) {
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      target.style.height = target.scrollHeight + 'px';
      requestAnimationFrame(function() {
        target.style.height = '0';
      });
    } else {
      toggle.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      target.style.height = target.scrollHeight + 'px';
      target.addEventListener('transitionend', function handler() {
        target.style.height = 'auto';
        target.removeEventListener('transitionend', handler);
      });
    }
  });

})();
</script>
