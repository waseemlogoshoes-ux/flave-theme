{{ 'autonex-stacking.css' | asset_url | stylesheet_tag }}
<script src="{{ 'autonex-stacking.js' | asset_url }}" defer></script>

<div class="atx-scroll-block" style="position:relative;z-index:{{ section.settings.z_index }};">
  <div class="atx-sticky-frame">
    <a href="{{ section.settings.button_url }}" class="atx-scene"
      {% if section.settings.image != blank %}
        style="background-image:url('{{ section.settings.image | image_url: width: 1920 }}');"
      {% else %}
        style="background:radial-gradient(ellipse at 60% 30%,rgba(201,162,75,.2),transparent 55%),linear-gradient(120deg,#0e0c09,#251c0f 45%,#0b0b0b);"
      {% endif %}>

      {% if section.settings.image_mobile != blank %}
      <style>
        @media(max-width:768px){
          .atx-hero-{{ section.id }}{
            background-image:url('{{ section.settings.image_mobile | image_url: width: 800 }}') !important;
          }
        }
      </style>
      {% endif %}
      <div class="atx-hero-{{ section.id }}" style="position:absolute;inset:0;background-size:cover;background-position:center;"></div>

      {% assign align = section.settings.text_align %}
      <div class="atx-overlay"
        style="
          {% if align == 'left' %}align-items:flex-start;text-align:left;{% elsif align == 'right' %}align-items:flex-end;text-align:right;{% endif %}
          background:linear-gradient(to bottom,rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}),rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.5 | divided_by: 100.0 }}));">
        {% if section.settings.eyebrow != blank %}<span class="atx-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
        {% if section.settings.heading != blank %}<h2 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p style="color:rgba(255,255,255,.8);font-size:16px;letter-spacing:.05em;margin-bottom:28px;max-width:560px;">{{ section.settings.subheading }}</p>{% endif %}
        {% if section.settings.button_label != blank %}<span class="atx-btn">{{ section.settings.button_label }}</span>{% endif %}
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Autonex Stacking Hero",
  "tag": "div",
  "settings": [
    {"type":"range","id":"z_index","min":10,"max":90,"step":10,"label":"Stack Order","default":10,"info":"10=first, 20=second, 30=third..."},
    {"type":"header","content":"Desktop Image"},
    {"type":"image_picker","id":"image","label":"Desktop Background Image","info":"Recommended: 1920×900px"},
    {"type":"header","content":"Mobile Image"},
    {"type":"image_picker","id":"image_mobile","label":"Mobile Background Image","info":"Recommended: 800×1000px (portrait)"},
    {"type":"header","content":"Content"},
    {"type":"select","id":"text_align","label":"Text Alignment","options":[{"value":"center","label":"Center"},{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"text","id":"eyebrow","label":"Eyebrow Text","default":"New Arrivals — Summer 2026"},
    {"type":"text","id":"heading","label":"Heading","default":"Crafted To Be Worn"},
    {"type":"range","id":"heading_size","min":28,"max":100,"step":4,"label":"Heading Size Desktop (px)","default":64},
    {"type":"text","id":"subheading","label":"Subheading (optional)"},
    {"type":"text","id":"button_label","label":"Button Label","default":"Shop The Collection"},
    {"type":"url","id":"button_url","label":"Button Link"},
    {"type":"header","content":"Overlay"},
    {"type":"range","id":"overlay_opacity","min":0,"max":70,"step":5,"label":"Overlay Darkness (%)","default":20}
  ],
  "presets":[{"name":"Autonex Stacking Hero"}]
}
{% endschema %}
