<div class="atx-scroll-block" style="position:relative;z-index:{{ section.settings.z_index }};">
  <div class="atx-sticky-frame" style="z-index:{{ section.settings.z_index }};">
    <div class="atx-scene atx-videos">

      {% if section.settings.cell1_image_mobile != blank or section.settings.cell2_image_mobile != blank %}
      <style>
        @media(max-width:768px){
          {% if section.settings.cell1_image_mobile != blank %}
          .atx-vcell-1-{{ section.id }}{background-image:url('{{ section.settings.cell1_image_mobile | image_url: width: 600 }}') !important;}
          {% endif %}
          {% if section.settings.cell2_image_mobile != blank %}
          .atx-vcell-2-{{ section.id }}{background-image:url('{{ section.settings.cell2_image_mobile | image_url: width: 600 }}') !important;}
          {% endif %}
        }
      </style>
      {% endif %}

      <a href="{{ section.settings.cell1_url }}" class="atx-vcell atx-vcell-1-{{ section.id }}"
        {% if section.settings.cell1_image != blank %}
          style="background-image:url('{{ section.settings.cell1_image | image_url: width: 960 }}');"
        {% else %}
          style="background:linear-gradient(155deg,#211a10,#4a3419 70%,#181310);"
        {% endif %}>
        {% if section.settings.show_play %}<div class="atx-play">▶</div>{% endif %}
        <div class="atx-vcap">
          {% if section.settings.cell1_eyebrow != blank %}<span class="atx-eyebrow">{{ section.settings.cell1_eyebrow }}</span>{% endif %}
          <h3>{{ section.settings.cell1_heading }}</h3>
        </div>
      </a>

      <a href="{{ section.settings.cell2_url }}" class="atx-vcell atx-vcell-2-{{ section.id }}"
        {% if section.settings.cell2_image != blank %}
          style="background-image:url('{{ section.settings.cell2_image | image_url: width: 960 }}');"
        {% else %}
          style="background:linear-gradient(205deg,#1a1411,#342414 60%,#131110);"
        {% endif %}>
        {% if section.settings.show_play %}<div class="atx-play">▶</div>{% endif %}
        <div class="atx-vcap">
          {% if section.settings.cell2_eyebrow != blank %}<span class="atx-eyebrow">{{ section.settings.cell2_eyebrow }}</span>{% endif %}
          <h3>{{ section.settings.cell2_heading }}</h3>
        </div>
      </a>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Autonex Stacking Split",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "z_index",
      "min": 10, "max": 90, "step": 10,
      "label": "Stack Order",
      "default": 40,
      "info": "Must be higher than previous section"
    },
    {
      "type": "checkbox",
      "id": "show_play",
      "label": "Show Play Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Left Cell"
    },
    {
      "type": "image_picker",
      "id": "cell1_image",
      "label": "Left — Desktop Image",
      "info": "960×1080px recommended"
    },
    {
      "type": "image_picker",
      "id": "cell1_image_mobile",
      "label": "Left — Mobile Image",
      "info": "600×800px recommended"
    },
    {
      "type": "text",
      "id": "cell1_eyebrow",
      "label": "Left Eyebrow",
      "default": "The Process"
    },
    {
      "type": "text",
      "id": "cell1_heading",
      "label": "Left Heading",
      "default": "Hand Finished"
    },
    {
      "type": "url",
      "id": "cell1_url",
      "label": "Left Link"
    },
    {
      "type": "header",
      "content": "Right Cell"
    },
    {
      "type": "image_picker",
      "id": "cell2_image",
      "label": "Right — Desktop Image",
      "info": "960×1080px recommended"
    },
    {
      "type": "image_picker",
      "id": "cell2_image_mobile",
      "label": "Right — Mobile Image",
      "info": "600×800px recommended"
    },
    {
      "type": "text",
      "id": "cell2_eyebrow",
      "label": "Right Eyebrow",
      "default": "Comfort Redefined"
    },
    {
      "type": "text",
      "id": "cell2_heading",
      "label": "Right Heading",
      "default": "Built For Every Day"
    },
    {
      "type": "url",
      "id": "cell2_url",
      "label": "Right Link"
    }
  ],
  "presets": [{"name": "Autonex Stacking Split"}]
}
{% endschema %}
