<div class="atx-scroll-block" style="position:relative;z-index:{{ section.settings.z_index }};">
  <div class="atx-sticky-frame" style="z-index:{{ section.settings.z_index }};">
    <a href="{{ section.settings.button_url }}" class="atx-scene"
      {% if section.settings.image != blank %}
        style="background-image:url('{{ section.settings.image | image_url: width: 1920 }}');"
      {% else %}
        style="background:radial-gradient(ellipse at 25% 70%,rgba(179,32,44,.2),transparent 50%),linear-gradient(240deg,#13100e,#261a12 50%,#0d0c0b);"
      {% endif %}>

      {% if section.settings.image_mobile != blank %}
      <style>
        @media(max-width:768px){
          #atx-banner-{{ section.id }}{
            background-image:url('{{ section.settings.image_mobile | image_url: width: 800 }}') !important;
          }
        }
      </style>
      {% endif %}

      {% if section.settings.text_position == 'left' %}
        <div class="atx-overlay-left" style="background:linear-gradient(to right,rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,rgba(0,0,0,.04) 70%);">
          {% if section.settings.eyebrow != blank %}<span class="atx-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
          <h2 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
          {% if section.settings.subheading != blank %}<p style="color:rgba(255,255,255,.8);font-size:15px;letter-spacing:.05em;margin-bottom:28px;max-width:480px;">{{ section.settings.subheading }}</p>{% endif %}
          {% if section.settings.button_label != blank %}<span class="atx-btn">{{ section.settings.button_label }}</span>{% endif %}
        </div>
      {% else %}
        <div class="atx-overlay" style="{% if section.settings.text_position == 'right' %}align-items:flex-end;text-align:right;{% endif %}background:linear-gradient(to bottom,rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}),rgba(0,0,0,{{ section.settings.overlay_opacity | times: 1.5 | divided_by: 100.0 }}));">
          {% if section.settings.eyebrow != blank %}<span class="atx-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
          <h2 style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
          {% if section.settings.subheading != blank %}<p style="color:rgba(255,255,255,.8);font-size:15px;letter-spacing:.05em;margin-bottom:28px;max-width:560px;">{{ section.settings.subheading }}</p>{% endif %}
          {% if section.settings.button_label != blank %}<span class="atx-btn">{{ section.settings.button_label }}</span>{% endif %}
        </div>
      {% endif %}

    </a>
  </div>
</div>

{% schema %}
{
  "name": "Autonex Stacking Banner",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "z_index",
      "min": 10, "max": 90, "step": 10,
      "label": "Stack Order",
      "default": 30,
      "info": "Must be higher than previous section"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        {"value": "center", "label": "Center"},
        {"value": "left", "label": "Left"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Background Image",
      "info": "Recommended: 1920×900px"
    },
    {
      "type": "header",
      "content": "Mobile Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image",
      "info": "Recommended: 800×1000px (portrait)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The New Classics"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28, "max": 100, "step": 4,
      "label": "Heading Size Desktop (px)",
      "default": 60
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0, "max": 70, "step": 5,
      "label": "Overlay Darkness (%)",
      "default": 25
    }
  ],
  "presets": [{"name": "Autonex Stacking Banner"}]
}
{% endschema %}
