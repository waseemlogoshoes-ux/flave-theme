            {% if block.settings.autoplay %}autoplay{% endif %}
            {% if block.settings.loop %}loop{% endif %}
            {% if block.settings.muted %}muted{% endif %}
            {% unless block.settings.show_controls %}controls{% endunless %}
            playsinline
            preload="metadata"
          >
            <source src="{{ block.settings.mobile_video_file }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% elsif block.settings.mobile_video_type == 'url' and block.settings.mobile_video_url != blank %}
          {% if block.settings.mobile_video_url contains 'youtube.com' or block.settings.mobile_video_url contains 'youtu.be' %}
            {% assign video_id = block.settings.mobile_video_url | split: '/' | last | split: '?' | first | split: '&' | first %}
            {% if block.settings.mobile_video_url contains 'watch?v=' %}
              {% assign video_id = block.settings.mobile_video_url | split: 'watch?v=' | last | split: '&' | first %}
            {% endif %}
            <iframe
              class="ai-video-element-{{ ai_gen_id }}"
              src="https://www.youtube.com/embed/{{ video_id }}?autoplay={{ block.settings.autoplay | default: 0 }}&loop={{ block.settings.loop | default: 0 }}&mute={{ block.settings.muted | default: 0 }}&controls={{ block.settings.show_controls | default: 1 }}"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          {% elsif block.settings.mobile_video_url contains 'vimeo.com' %}
            {% assign video_id = block.settings.mobile_video_url | split: '/' | last %}
            <iframe
              class="ai-video-element-{{ ai_gen_id }}"
              src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ block.settings.autoplay | default: 0 }}&loop={{ block.settings.loop | default: 0 }}&muted={{ block.settings.muted | default: 0 }}"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          {% else %}
