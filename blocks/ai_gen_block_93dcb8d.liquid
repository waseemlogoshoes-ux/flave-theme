{% doc %}
  @prompt
    i need job hiring page with application forma. submit form option: mnaual add hr email & whatsapp submiting, https://www.logoofficial.com/pages/career  es url par jo page deaign hoya ha or es me jo form ha muj esa chyee  please make

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-career-page-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 60px 20px;
  }

  .ai-career-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-career-hero-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 80px;
    color: white;
  }

  .ai-career-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 700;
    margin: 0 0 20px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .ai-career-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_subtitle_size }}px;
    margin: 0 0 40px;
    opacity: 0.9;
    max-width: 600px;margin-left: auto;
    margin-right: auto;
  }

  .ai-career-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-bottom: 80px;
  }

  .ai-career-stat-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 30px 20px;
    text-align: center;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ai-career-stat-number-{{ ai_gen_id }} {
    font-size: 36px;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .ai-career-stat-label-{{ ai_gen_id }} {
    font-size: 16px;
    opacity: 0.9;
    margin: 0;
  }

  .ai-career-form-section-{{ ai_gen_id }} {
    background: white;
    border-radius: 20px;
    padding: 50px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);margin-bottom: 60px;
  }

  .ai-career-form-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.form_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.form_title_color }};
    margin: 0 0 40px;
  }

  .ai-career-form-{{ ai_gen_id }} {
    display: grid;
    gap: 25px;
  }

  .ai-career-form-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }

  .ai-career-form-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;gap: 8px;
  }

  .ai-career-label-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.label_color }};
    font-size: 14px;
  }

  .ai-career-input-{{ ai_gen_id }},
  .ai-career-textarea-{{ ai_gen_id }},
  .ai-career-select-{{ ai_gen_id }} {
    padding: 15px 20px;
    border: 2px solid #e1e5e9;
    border-radius: 12px;
    font-size: 16px;
    background-color: #f8f9fa;
    color: {{ block.settings.text_color }};
    transition: all 0.3s ease;
  }

  .ai-career-input-{{ ai_gen_id }}:focus,
  .ai-career-textarea-{{ ai_gen_id }}:focus,
  .ai-career-select-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.primary_color }};
    background-color: white;
    box-shadow: 0 0 0 3px {{ block.settings.primary_color }}20;
  }

  .ai-career-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-career-file-upload-{{ ai_gen_id }} {
    position: relative;
    border: 2px dashed #e1e5e9;
    border-radius: 12px;
    padding: 40px 20px;
    text-align: center;
    background-color: #f8f9fa;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-career-file-upload-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.primary_color }};
    background-color: {{ block.settings.primary_color }}10;
  }

  .ai-career-file-upload-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 15px;
    color: {{ block.settings.primary_color }};
  }

  .ai-career-file-upload-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    font-weight: 500;
  }

  .ai-career-file-upload-subtext-{{ ai_gen_id }} {
    color: #6c757d;
    font-size: 14px;
    margin-top: 5px;
  }

  .ai-career-submission-methods-{{ ai_gen_id }} {
    margin: 40px 0;
  }

  .ai-career-submission-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;text-align: center;
  }

  .ai-career-submission-options-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
  }

  .ai-career-submission-option-{{ ai_gen_id }} {
    padding: 25px;
    border: 2px solid #e1e5e9;
    border-radius: 15px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #f8f9fa;
  }

  .ai-career-submission-option-{{ ai_gen_id }}.active {
    border-color: {{ block.settings.primary_color }};
    background: {{ block.settings.primary_color }}10;
  }

  .ai-career-submission-icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    margin: 0 auto 15px;
    color: {{ block.settings.primary_color }};
  }

  .ai-career-submission-option-title-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 8px;
    font-size: 16px;
  }

  .ai-career-submission-option-desc-{{ ai_gen_id }} {
    color: #6c757d;
    font-size: 14px;
    margin: 0;
  }

  .ai-career-contact-fields-{{ ai_gen_id }} {
    display: none;
    gap: 25px;
  }

  .ai-career-contact-fields-{{ ai_gen_id }}.active {
    display: grid;
  }

  .ai-career-submit-btn-{{ ai_gen_id }} {
    background: linear-gradient(135deg, {{ block.settings.primary_color }} 0%, {{ block.settings.secondary_color }} 100%);
    color: white;
    border: none;
    padding: 18px 40px;
    border-radius: 12px;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px {{ block.settings.primary_color }}40;
  }

  .ai-career-submit-btn-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px {{ block.settings.primary_color }}50;
  }

  .ai-career-success-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    color: white;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    margin-top: 20px;
  }

  .ai-career-error-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
    color: white;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    margin-top: 20px;
  }

  .ai-career-benefits-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 60px;
  }

  .ai-career-benefit-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 30px;
    text-align: center;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ai-career-benefit-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    margin: 0 auto 20px;
    color: #ffd700;
  }

  .ai-career-benefit-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 10px;
  }

  .ai-career-benefit-desc-{{ ai_gen_id }} {
    font-size: 14px;
    opacity: 0.9;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-career-page-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-career-form-section-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-career-form-row-{{ ai_gen_id }},
    .ai-career-submission-options-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-career-hero-title-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-career-hero-subtitle-{{ ai_gen_id }} {
      font-size: 16px;
    }
  }
{% endstyle %}<career-application-{{ ai_gen_id }}
  class="ai-career-page-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-career-container-{{ ai_gen_id }}">
    <div class="ai-career-hero-{{ ai_gen_id }}">
      {% if block.settings.hero_title != blank %}
        <h1 class="ai-career-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
      {% endif %}
      {% if block.settings.hero_subtitle != blank %}
        <p class="ai-career-hero-subtitle-{{ ai_gen_id }}">{{ block.settings.hero_subtitle }}</p>
      {% endif %}
    </div>

    {% if block.settings.show_stats %}
      <div class="ai-career-stats-{{ ai_gen_id }}">
        <div class="ai-career-stat-{{ ai_gen_id }}">
          <div class="ai-career-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_1_number }}</div>
          <div class="ai-career-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
        </div>
        <div class="ai-career-stat-{{ ai_gen_id }}">
          <div class="ai-career-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_2_number }}</div>
          <div class="ai-career-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
        </div>
        <div class="ai-career-stat-{{ ai_gen_id }}">
          <div class="ai-career-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_3_number }}</div>
          <div class="ai-career-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
        </div>
        <div class="ai-career-stat-{{ ai_gen_id }}">
          <div class="ai-career-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_4_number }}</div>
          <div class="ai-career-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
        </div>
      </div>
    {% endif %}<div class="ai-career-form-section-{{ ai_gen_id }}">
      {% if block.settings.form_title != blank %}
        <h2 class="ai-career-form-title-{{ ai_gen_id }}">{{ block.settings.form_title }}</h2>
      {% endif %}

      {%- form 'contact' -%}
        <div class="ai-career-form-{{ ai_gen_id }}">
          <div class="ai-career-form-row-{{ ai_gen_id }}">
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">First Name *</label>
              <input
                type="text"
                id="first-name-{{ ai_gen_id }}"
                name="contact[first_name]"
                class="ai-career-input-{{ ai_gen_id }}"
                required
                value="{{ form.first_name }}"
              >
            </div>
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">Last Name *</label>
              <input
                type="text"
                id="last-name-{{ ai_gen_id }}"
                name="contact[last_name]"
                class="ai-career-input-{{ ai_gen_id }}"
                required
                value="{{ form.last_name }}"
              >
            </div>
          </div>

          <div class="ai-career-form-row-{{ ai_gen_id }}">
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">Email Address *</label>
              <input
                type="email"
                id="email-{{ ai_gen_id }}"
                name="contact[email]"
                class="ai-career-input-{{ ai_gen_id }}"
                required
                value="{{ form.email }}"
              >
            </div>
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">Phone Number *</label>
              <input
                type="tel"
                id="phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-career-input-{{ ai_gen_id }}"
                required
                value="{{ form.phone }}"
              >
            </div>
          </div>

          <div class="ai-career-form-row-{{ ai_gen_id }}">
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="position-{{ ai_gen_id }}">Position Applied For *</label>
              <select
                id="position-{{ ai_gen_id }}"
                name="contact[position]"
                class="ai-career-select-{{ ai_gen_id }}"
                required
              >
                <option value="">Select Position</option>
                <option value="Frontend Developer">Frontend Developer</option>
                <option value="Backend Developer">Backend Developer</option>
                <option value="Full Stack Developer">Full Stack Developer</option>
                <option value="UI/UX Designer">UI/UX Designer</option>
                <option value="Graphic Designer">Graphic Designer</option>
                <option value="Digital Marketing Specialist">Digital Marketing Specialist</option>
                <option value="Project Manager">Project Manager</option>
                <option value="Business Analyst">Business Analyst</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="experience-{{ ai_gen_id }}">Years of Experience</label>
              <select
                id="experience-{{ ai_gen_id }}"
                name="contact[experience]"
                class="ai-career-select-{{ ai_gen_id }}"
              >
                <option value="">Select Experience</option>
                <option value="Fresh Graduate">Fresh Graduate</option>
                <option value="0-1 years">0-1 years</option>
                <option value="2-3 years">2-3 years</option>
                <option value="4-5 years">4-5 years</option>
                <option value="6-10 years">6-10 years</option>
                <option value="10+ years">10+ years</option>
              </select>
            </div>
          </div>

          <div class="ai-career-form-row-{{ ai_gen_id }}">
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="salary-{{ ai_gen_id }}">Expected Salary (PKR)</label>
              <input
                type="text"
                id="salary-{{ ai_gen_id }}"
                name="contact[expected_salary]"
                class="ai-career-input-{{ ai_gen_id }}"
                placeholder="e.g. 50,000 - 80,000"
                value="{{ form.expected_salary }}"
              >
            </div>
            <div class="ai-career-form-group-{{ ai_gen_id }}">
              <label class="ai-career-label-{{ ai_gen_id }}" for="availability-{{ ai_gen_id }}">Availability</label>
              <select
                id="availability-{{ ai_gen_id }}"
                name="contact[availability]"
                class="ai-career-select-{{ ai_gen_id }}"
              >
                <option value="">Select Availability</option>
                <option value="Immediately">Immediately</option>
                <option value="2 weeks notice">2 weeks notice</option>
                <option value="1 month notice">1 month notice</option>
                <option value="2 months notice">2 months notice</option>
              </select>
            </div>
          </div>

          <div class="ai-career-form-group-{{ ai_gen_id }}">
            <label class="ai-career-label-{{ ai_gen_id }}" for="cover-letter-{{ ai_gen_id }}">Cover Letter / Whydo you want to join us? *</label>
            <textarea
              id="cover-letter-{{ ai_gen_id }}"
              name="contact[cover_letter]"
              class="ai-career-textarea-{{ ai_gen_id }}"
              placeholder="Tell us about yourself, your skills, and why you're interested in joining our team..."
              required
            >{{ form.cover_letter }}</textarea>
          </div>

          <div class="ai-career-form-group-{{ ai_gen_id }}">
            <label class="ai-career-label-{{ ai_gen_id }}">Upload Resume / CV *</label>
            <div class="ai-career-file-upload-{{ ai_gen_id }}" onclick="document.getElementById('resume-{{ ai_gen_id }}').click()">
              <svg class="ai-career-file-upload-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
              <div class="ai-career-file-upload-text-{{ ai_gen_id }}">Click to upload your resume</div>
              <div class="ai-career-file-upload-subtext-{{ ai_gen_id }}">PDF, DOC, DOCX (Max 5MB)</div>
              <input
                type="file"
                id="resume-{{ ai_gen_id }}"
                name="contact[resume]"
                accept=".pdf,.doc,.docx"
                style="display: none;"required
              >
            </div>
          </div>

          <div class="ai-career-submission-methods-{{ ai_gen_id }}">
            <h3 class="ai-career-submission-title-{{ ai_gen_id }}">Choose Submission Method</h3>
            <div class="ai-career-submission-options-{{ ai_gen_id }}">
              <div class="ai-career-submission-option-{{ ai_gen_id }} active" data-method="email">
                <svg class="ai-career-submission-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <h4 class="ai-career-submission-option-title-{{ ai_gen_id }}">Email Submission</h4>
                <p class="ai-career-submission-option-desc-{{ ai_gen_id }}">Send application directly to HR email</p>
              </div>
              <div class="ai-career-submission-option-{{ ai_gen_id }}" data-method="whatsapp">
                <svg class="ai-career-submission-icon-{{ ai_gen_id }}" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.109"/>
                </svg>
                <h4 class="ai-career-submission-option-title-{{ ai_gen_id }}">WhatsApp Submission</h4>
                <p class="ai-career-submission-option-desc-{{ ai_gen_id }}">Send application via WhatsApp</p>
              </div>
            </div>

            <div class="ai-career-contact-fields-{{ ai_gen_id }} active" id="email-fields-{{ ai_gen_id }}">
              <div class="ai-career-form-group-{{ ai_gen_id }}">
                <label class="ai-career-label-{{ ai_gen_id }}" for="hr-email-{{ ai_gen_id }}">HR Email Address *</label>
                <input
                  type="email"
                  id="hr-email-{{ ai_gen_id }}"
                  name="contact[hr_email]"
                  class="ai-career-input-{{ ai_gen_id }}"
                  value="{{ block.settings.default_hr_email }}"
                  required
                >
              </div>
            </div>

            <div class="ai-career-contact-fields-{{ ai_gen_id }}" id="whatsapp-fields-{{ ai_gen_id }}">
              <div class="ai-career-form-group-{{ ai_gen_id }}">
                <label class="ai-career-label-{{ ai_gen_id }}" for="hr-whatsapp-{{ ai_gen_id }}">HR WhatsApp Number *</label>
                <input
                  type="tel"
                  id="hr-whatsapp-{{ ai_gen_id }}"
                  name="contact[hr_whatsapp]"
                  class="ai-career-input-{{ ai_gen_id }}"
                  placeholder="+92 300 1234567"
                  value="{{ block.settings.default_whatsapp_number }}"
                >
              </div>
            </div>
          </div>

          <input type="hidden" name="contact[submission_method]" id="submission-method-{{ ai_gen_id }}" value="email">

          <button type="submit" class="ai-career-submit-btn-{{ ai_gen_id }}">
            Submit Application
          </button>

          {%- if form.posted_successfully? -%}
            <div class="ai-career-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="ai-career-error-{{ ai_gen_id }}">
              <p>Please correct the following errors:</p>
              {%- for field in form.errors -%}
                <p>{{ field[1] }}</p>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>

    {% if block.settings.show_benefits %}
