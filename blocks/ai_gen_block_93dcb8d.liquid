<script>
  (function() {
    class CareerApplication{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupSubmissionMethods();
        this.setupFileUpload();
      }

      setupSubmissionMethods() {
        const options = this.querySelectorAll('.ai-career-submission-option-{{ ai_gen_id }}');
        const emailFields = this.querySelector('#email-fields-{{ ai_gen_id }}');
        const whatsappFields = this.querySelector('#whatsapp-fields-{{ ai_gen_id }}');
        const submissionMethodInput = this.querySelector('#submission-method-{{ ai_gen_id }}');

        options.forEach(option => {
          option.addEventListener('click', () => {
            options.forEach(opt => opt.classList.remove('active'));
            option.classList.add('active');

            const method = option.dataset.method;
            submissionMethodInput.value = method;

            if (method === 'email') {
              emailFields.classList.add('active');
              whatsappFields.classList.remove('active');
              this.querySelector('#hr-email-{{ ai_gen_id }}').required = true;
              this.querySelector('#hr-whatsapp-{{ ai_gen_id }}').required = false;
            } else {
              emailFields.classList.remove('active');
              whatsappFields.classList.add('active');
              this.querySelector('#hr-email-{{ ai_gen_id }}').required = false;
              this.querySelector('#hr-whatsapp-{{ ai_gen_id }}').required = true;
            }
          });
        });
      }

      setupFileUpload() {
        const fileInput = this.querySelector('#resume-{{ ai_gen_id }}');
        const fileUploadText = this.querySelector('.ai-career-file-upload-text-{{ ai_gen_id }}');

        fileInput.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) {
            fileUploadText.textContent = `Selected: ${file.name}`;} else {
            fileUploadText.textContent = 'Click to upload your resume';
          }
        });
      }
    }

    customElements.define('career-application-{{ ai_gen_id }}', CareerApplication{{ ai_gen_id }});
  })();
</script>

