{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-job-hiring-page-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-job-hiring-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-job-hiring-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 20px;font-weight: 600;
  }

  .ai-job-hiring-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-job-listings-{{ ai_gen_id }} {
    display: grid;
    gap: 30px;
    margin-bottom: 60px;
  }

  .ai-job-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-job-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-job-card-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    gap: 20px;
  }

  .ai-job-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 24px;
    margin: 0;
    font-weight: 600;
  }

  .ai-job-type-{{ ai_gen_id }} {
    background-color: {{ block.settings.job_type_bg_color }};
    color: {{ block.settings.job_type_text_color }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ai-job-details-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .ai-job-detail-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-job-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .ai-job-apply-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .ai-job-apply-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 12px 24px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ai-job-apply-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-job-email-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.email_button_color }};
    color: {{ block.settings.email_button_text_color }};
    border: 1px solid {{ block.settings.email_button_border_color }};
  }

  .ai-job-email-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.email_button_hover_color }};
  }

  .ai-application-form-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px;
    margin-top: 40px;
  }

  .ai-form-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 28px;
    margin: 0 0 30px;
    font-weight: 600;
    text-align: center;
  }

  .ai-form-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .ai-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-form-field-full-{{ ai_gen_id }} {
    grid-column: 1 / -1;
  }

  .ai-form-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 500;}

  .ai-form-input-{{ ai_gen_id }},
  .ai-form-textarea-{{ ai_gen_id }},
  .ai-form-select-{{ ai_gen_id }} {
    padding: 12px16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-form-textarea-{{ ai_gen_id }} {
    resize: vertical;
    min-height: 120px;
  }

  .ai-form-submit-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    padding: 15px 30px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
    margin-top: 20px;
    transition: background-color 0.2s ease;
  }

  .ai-form-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-form-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    background-color: {{ block.settings.success_bg_color }};
    padding: 15px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: 20px;text-align: center;
  }

  .ai-form-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    background-color: {{ block.settings.error_bg_color }};
    padding: 15px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-top: 20px;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
  }

  .ai-application-methods-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px;
    margin-top: 40px;text-align: center;
  }

  .ai-methods-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 28px;
    margin: 0 0 20px;
    font-weight: 600;
  }

  .ai-methods-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin-bottom: 30px;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-application-options-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-option-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border: 1px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 30px;
    flex: 1;
    min-width: 250px;
    max-width: 350px;
  }

  .ai-option-title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 20px;
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-option-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .ai-job-hiring-page-{{ ai_gen_id }} {
      padding: 30px 15px;
    }

    .ai-job-card-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .ai-job-details-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 10px;
    }

    .ai-job-apply-buttons-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-form-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-application-form-{{ ai_gen_id }},
    .ai-application-methods-{{ ai_gen_id }} {
      padding: 30px20px;
    }

    .ai-application-options-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }
{% endstyle %}<job-hiring-page-{{ ai_gen_id }}
  class="ai-job-hiring-page-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-job-hiring-header-{{ ai_gen_id }}">
    {% if block.settings.page_title != blank %}
      <h1 class="ai-job-hiring-title-{{ ai_gen_id }}">{{ block.settings.page_title }}</h1>
    {% endif %}
    {% if block.settings.page_subtitle != blank %}
      <div class="ai-job-hiring-subtitle-{{ ai_gen_id }}">{{ block.settings.page_subtitle }}</div>
    {% endif %}
  </div>

  <div class="ai-job-listings-{{ ai_gen_id }}">
    {% assign has_jobs = false %}
    {% for i in (1..5) %}
      {% liquid
        assign job_title_key = 'job_' | append: i | append: '_title'
        assign job_type_key = 'job_' | append: i | append: '_type'
        assign job_location_key = 'job_' | append: i | append: '_location'
        assign job_salary_key = 'job_' | append: i | append: '_salary'
        assign job_description_key = 'job_' | append: i | append: '_description'
        assign job_enabled_key = 'job_' | append: i | append: '_enabled'

        assign job_title = block.settings[job_title_key]
        assign job_type = block.settings[job_type_key]
        assign job_location = block.settings[job_location_key]
        assign job_salary = block.settings[job_salary_key]
        assign job_description = block.settings[job_description_key]
        assign job_enabled = block.settings[job_enabled_key]%}

      {% if job_enabled and job_title != blank %}
        {% assign has_jobs = true %}
        <div class="ai-job-card-{{ ai_gen_id }}" data-job-id="{{ i }}">
          <div class="ai-job-card-header-{{ ai_gen_id }}">
            <h2 class="ai-job-title-{{ ai_gen_id }}">{{ job_title }}</h2>
            {% if job_type != blank %}
              <span class="ai-job-type-{{ ai_gen_id }}">{{ job_type }}</span>
            {% endif %}
          </div>

          <div class="ai-job-details-{{ ai_gen_id }}">
            {% if job_location != blank %}
              <div class="ai-job-detail-{{ ai_gen_id }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {{ job_location }}
              </div>
            {% endif %}
            {% if job_salary != blank %}
              <div class="ai-job-detail-{{ ai_gen_id }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                {{ job_salary }}
              </div>
            {% endif %}
          </div>

          {% if job_description != blank %}
            <div class="ai-job-description-{{ ai_gen_id }}">{{ job_description }}</div>
          {% endif %}

          <div class="ai-job-apply-buttons-{{ ai_gen_id }}">
            <button
              class="ai-job-apply-button-{{ ai_gen_id }}"
              data-apply-job="{{ i }}"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14,2 14,8 20,8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10,9 9,9 8,9"></polyline>
              </svg>
              Apply with Form
            </button>

            {% if block.settings.hr_email != blank %}
              <a
                href="mailto:{{ block.settings.hr_email }}?subject=Application for {{ job_title | url_encode }}&body=Dear Hiring Manager,%0D%0A%0D%0AI am interested in applying for the {{ job_title | url_encode }} position.%0D%0A%0D%0APlease find my resume attached.%0D%0A%0D%0AThank you for your consideration.%0D%0A%0D%0ABest regards"
                class="ai-job-apply-button-{{ ai_gen_id }} ai-job-email-button-{{ ai_gen_id }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Apply via Email
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% unless has_jobs %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        <h3>No job openings at the moment</h3>
        <p>Check back later for new opportunities!</p>
      </div>
    {% endunless %}
  </div>

  {% if has_jobs %}
    {% if block.settings.show_application_methods %}
      <div class="ai-application-methods-{{ ai_gen_id }}">
        <h2 class="ai-methods-title-{{ ai_gen_id }}">How to Apply</h2>
        <p class="ai-methods-subtitle-{{ ai_gen_id }}">Choose your preferred application method</p>
        
        <div class="ai-application-options-{{ ai_gen_id }}">
          <div class="ai-option-card-{{ ai_gen_id }}">
            <h3 class="ai-option-title-{{ ai_gen_id }}">Online Form</h3>
            <p class="ai-option-description-{{ ai_gen_id }}">Fill out our quick application form below. All information is submitted securely.</p>
            <button
              class="ai-job-apply-button-{{ ai_gen_id }}"
              data-scroll-to-form>
              Use Application Form
            </button>
          </div>

          {% if block.settings.hr_email != blank %}
            <div class="ai-option-card-{{ ai_gen_id }}">
              <h3 class="ai-option-title-{{ ai_gen_id }}">Email Application</h3>
              <p class="ai-option-description-{{ ai_gen_id }}">Send your resume and cover letter directly to our HR team at {{ block.settings.hr_email }}.</p>
              <a
                href="mailto:{{ block.settings.hr_email }}?subject=Job Application&body=Dear Hiring Manager,%0D%0A%0D%0AI am interested in applying for a position at your company.%0D%0A%0D%0APlease find my resume attached.%0D%0A%0D%0AThank you for your consideration.%0D%0A%0D%0ABest regards"
                class="ai-job-apply-button-{{ ai_gen_id }} ai-job-email-button-{{ ai_gen_id }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Send Email
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% form 'contact' %}
      <div class="ai-application-form-{{ ai_gen_id }}" id="application-form-{{ ai_gen_id }}">
        <h2 class="ai-form-title-{{ ai_gen_id }}">Apply for Position</h2>

        <input type="hidden" name="contact[subject]" value="Job Application" id="selected-job-{{ ai_gen_id }}">

        <div class="ai-form-grid-{{ ai_gen_id }}">
          <div class="ai-form-field-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">First Name *</label>
            <input
              type="text"
              class="ai-form-input-{{ ai_gen_id }}"
              id="first-name-{{ ai_gen_id }}"
              name="contact[first_name]"
              required
            >
          </div>

          <div class="ai-form-field-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">Last Name *</label>
            <input
              type="text"
              class="ai-form-input-{{ ai_gen_id }}"
              id="last-name-{{ ai_gen_id }}"
              name="contact[last_name]"
              required
            >
          </div>

          <div class="ai-form-field-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">Email *</label>
            <input
              type="email"
              class="ai-form-input-{{ ai_gen_id }}"
              id="email-{{ ai_gen_id }}"
              name="contact[email]"
              required
            >
          </div>

          <div class="ai-form-field-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">Phone</label>
            <input
              type="tel"
              class="ai-form-input-{{ ai_gen_id }}"
              id="phone-{{ ai_gen_id }}"
              name="contact[phone]"
            >
          </div>

          <div class="ai-form-field-{{ ai_gen_id }} ai-form-field-full-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="position-{{ ai_gen_id }}">Position Applied For *</label>
            <select
              class="ai-form-select-{{ ai_gen_id }}"
              id="position-{{ ai_gen_id }}"
              name="contact[position]"
              required
            >
              <option value="">Select a position</option>
              {% for i in (1..5) %}
                {% liquid
                  assign job_title_key = 'job_' | append: i | append: '_title'
                  assign job_enabled_key = 'job_' | append: i | append: '_enabled'
                  assign job_title = block.settings[job_title_key]
                  assign job_enabled = block.settings[job_enabled_key]
                %}
                {% if job_enabled and job_title != blank %}
                  <option value="{{ job_title }}">{{ job_title }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>

          <div class="ai-form-field-{{ ai_gen_id }} ai-form-field-full-{{ ai_gen_id }}">
            <label class="ai-form-label-{{ ai_gen_id }}" for="cover-letter-{{ ai_gen_id }}">Cover Letter</label>
            <textarea
              class="ai-form-textarea-{{ ai_gen_id }}"
              id="cover-letter-{{ ai_gen_id }}"
              name="contact[body]"
              placeholder="Tell us why you're interested in this position..."></textarea>
          </div>
        </div>

        <button type="submit" class="ai-form-submit-{{ ai_gen_id }}">
          Submit Application
        </button>

        {% if form.posted_successfully? %}
          <div class="ai-form-success-{{ ai_gen_id }}">
            Thank you for your application! We'll review it and get back to you soon.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="ai-form-error-{{ ai_gen_id }}">
            {% for field in form.errors %}
              <p>{{ field | capitalize }} {{ form.errors.messages[field] }}</p>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endform %}
  {% endif %}
</job-hiring-page-{{ ai_gen_id }}><script>
  (function() {
    class JobHiringPage{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        const applyButtons = this.querySelectorAll('[data-apply-job]');
        const scrollToFormButtons = this.querySelectorAll('[data-scroll-to-form]');
        const positionSelect = this.querySelector('#position-{{ ai_gen_id }}');
        const applicationForm = this.querySelector('#application-form-{{ ai_gen_id }}');

        applyButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const jobId = e.target.getAttribute('data-apply-job');
            const jobCard = this.querySelector(`[data-job-id="${jobId}"]`);
            const jobTitle = jobCard.querySelector('.ai-job-title-{{ ai_gen_id }}').textContent;

            if (positionSelect) {
              positionSelect.value = jobTitle;
            }

            if (applicationForm) {
              applicationForm.scrollIntoView({ behavior: 'smooth' });
            }
          });
        });

        scrollToFormButtons.forEach(button => {
          button.addEventListener('click', () => {
            if (applicationForm) {
              applicationForm.scrollIntoView({ behavior: 'smooth' });
            }
          });
        });
      }
    }

    customElements.define('job-hiring-page-{{ ai_gen_id }}', JobHiringPage{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Job hiring page",
  "settings": [
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "Join Our Team"
    },
    {
      "type": "richtext",
      "id": "page_subtitle",
      "label": "Page subtitle",
      "default": "<p>We're looking for talented individuals to help us grow. Explore our open positions and find your next career opportunity.</p>"
    },
    {
      "type": "header",
      "content": "Application settings"
    },
    {
      "type": "checkbox",
      "id": "show_application_methods",
      "label": "Show application methods section",
      "default": true
    },
    {
      "type": "text",
      "id": "hr_email",
      "label": "HR email address",
      "info": "Email address where job applications will be sent. Leave empty to hide email application option."
    },
    {
      "type": "header",
      "content": "Job position 1"
    },
    {
      "type": "checkbox",
      "id": "job_1_enabled",
      "label": "Enable job position 1",
      "default": true
    },
    {
      "type": "text",
      "id": "job_1_title",
      "label": "Job title",
      "default": "Frontend Developer"
    },
    {
      "type": "text",
      "id": "job_1_type",
      "label": "Job type",
      "default": "Full-time"
    },
    {
      "type": "text",
      "id": "job_1_location",
      "label": "Location",
      "default": "Remote"
    },
    {
      "type": "text",
      "id": "job_1_salary",
      "label": "Salary range",
      "default": "$60,000 - $80,000"
    },
    {
      "type": "richtext",
      "id": "job_1_description",
      "label": "Job description",
