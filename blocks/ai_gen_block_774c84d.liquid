{% doc %}
  @prompt
    deiveder line bana ke do us ka size ho alingment ho or color ke option , mobile with ni ha, es me mobile width ni ha
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-divider-line-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    border: none;
    margin: 0;
    
    {% if block.settings.alignment == 'left' %}
      margin-left: 0;
      margin-right: auto;
    {% elsif block.settings.alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.alignment == 'right' %}
      margin-left: auto;
      margin-right: 0;
    {% endif %}
  }

  .ai-divider-{{ ai_gen_id }}--style-dashed .ai-divider-line-{{ ai_gen_id }} {
    background: none;
    border-top: {{ block.settings.line_thickness }}px dashed {{ block.settings.line_color }};
    height: 0;
  }

  .ai-divider-{{ ai_gen_id }}--style-dotted .ai-divider-line-{{ ai_gen_id }} {
    background: none;
    border-top: {{ block.settings.line_thickness }}px dotted {{ block.settings.line_color }};
    height: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-divider-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-divider-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_width_percent }}%;
      padding: {{ block.settings.spacing_top | times: 0.7 }}px 0 {{ block.settings.spacing_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div 
  class="ai-divider-{{ ai_gen_id }} ai-divider-{{ ai_gen_id }}--style-{{ block.settings.line_style }}"
  {{ block.shopify_attributes }}
>
  <hr class="ai-divider-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Divider line",
  "settings": [
    {
      "type": "header",
      "content": "Line style"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Color",
      "default": "#1c1d1d"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_width_percent",
      "label": "Mobile width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Divider line"
    }
  ]
}
{% endschema %}
