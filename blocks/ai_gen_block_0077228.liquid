{% doc %}
  @prompt
    Mujhe ek Hero Video Slider banana hai jisme multiple video slides hon, ek video khatam hone ke baad doosri automatically chale, desktop aur mobile ke liye alag video upload ho, navigation arrows aur dot indicators hon, har slide ka apna heading, subheading aur CTA button ho. Smooth fade/slide transition ho aur full-width responsive layout ho.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-video-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-video-slider__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-video-slider__container-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-hero-video-slider__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.transition_duration }}s ease-in-out;
  }

  .ai-hero-video-slider__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-hero-video-slider__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-video-slider__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-video-slider__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 3;
    width: 90%;
    max-width: 800px;
  }

  .ai-hero-video-slider__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  @media screen and (max-width: 749px) {
    .ai-hero-video-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }
  }

  .ai-hero-video-slider__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  @media screen and (max-width: 749px) {
    .ai-hero-video-slider__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.7 }}px;
    }
  }

  .ai-hero-video-slider__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-hero-video-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-hero-video-slider__navigation-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    background-color: {{ block.settings.arrow_bg_color }};
    color: {{ block.settings.arrow_color }};
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    opacity: {{ block.settings.arrow_opacity | divided_by: 100.0 }};
  }

  .ai-hero-video-slider__navigation-{{ ai_gen_id }}:hover {
    opacity: 1;
    background-color: {{ block.settings.arrow_hover_bg_color }};
  }

  .ai-hero-video-slider__navigation--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-hero-video-slider__navigation--next-{{ ai_gen_id }} {
    right: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-video-slider__navigation-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-hero-video-slider__navigation--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-hero-video-slider__navigation--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }

  .ai-hero-video-slider__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 4;
  }

  .ai-hero-video-slider__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: {{ block.settings.dot_opacity | divided_by: 100.0 }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-hero-video-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    background-color: {{ block.settings.dot_active_color }};
  }

  .ai-hero-video-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-video-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-video-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<hero-video-slider-{{ ai_gen_id }}
  class="ai-hero-video-slider-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-transition-duration="{{ block.settings.transition_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-video-slider__container-{{ ai_gen_id }}">
    {% liquid
      assign slide_1_enabled = block.settings.slide_1_enabled
      assign slide_2_enabled = block.settings.slide_2_enabled
      assign slide_3_enabled = block.settings.slide_3_enabled
      assign slide_4_enabled = block.settings.slide_4_enabled
      assign slide_5_enabled = block.settings.slide_5_enabled

      assign total_slides = 0
      if slide_1_enabled
        assign total_slides = total_slides | plus: 1
      endif
      if slide_2_enabled
        assign total_slides = total_slides | plus: 1
      endif
      if slide_3_enabled
        assign total_slides = total_slides | plus: 1
      endif
      if slide_4_enabled
        assign total_slides = total_slides | plus: 1
      endif
      if slide_5_enabled
        assign total_slides = total_slides | plus: 1
      endif
    %}

    {% if total_slides == 0 %}
      <div class="ai-hero-video-slider__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-video-slider__empty-state-{{ ai_gen_id }}">
          Next, enable and configure your video slides
        </div>
      </div>
    {% else %}
      {% for i in (1..5) %}
        {% liquid
          assign enabled_key = 'slide_' | append: i | append: '_enabled'
          assign desktop_video_key = 'slide_' | append: i | append: '_desktop_video'
          assign mobile_video_key = 'slide_' | append: i | append: '_mobile_video'
          assign heading_key = 'slide_' | append: i | append: '_heading'
          assign subheading_key = 'slide_' | append: i | append: '_subheading'
          assign button_text_key = 'slide_' | append: i | append: '_button_text'
          assign button_link_key = 'slide_' | append: i | append: '_button_link'

          assign is_enabled = block.settings[enabled_key]
          assign desktop_video = block.settings[desktop_video_key]
          assign mobile_video = block.settings[mobile_video_key]
          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}

        {% if is_enabled %}
          <div
            class="ai-hero-video-slider__slide-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide-index="{{ forloop.index }}"
          >
            {% if desktop_video != blank or mobile_video != blank %}
              <video
                class="ai-hero-video-slider__video-{{ ai_gen_id }} ai-hero-video-slider__video--desktop-{{ ai_gen_id }}"
                autoplay
                muted
                playsinline
                data-video-type="desktop"
              >
                {% if desktop_video != blank %}
                  <source src="{{ desktop_video }}" type="video/mp4">
                {% endif %}
              </video>

              {% if mobile_video != blank %}
                <video
                  class="ai-hero-video-slider__video-{{ ai_gen_id }} ai-hero-video-slider__video--mobile-{{ ai_gen_id }}"
                  autoplay
                  muted
                  playsinline
                  data-video-type="mobile"
                  style="display: none;"
                >
                  <source src="{{ mobile_video }}" type="video/mp4">
                </video>
              {% endif %}
            {% else %}
              <div class="ai-hero-video-slider__placeholder-{{ ai_gen_id }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag }}
                <div class="ai-hero-video-slider__empty-state-{{ ai_gen_id }}">
                  Next, add a video for slide {{ i }}
                </div>
              </div>
            {% endif %}

            <div class="ai-hero-video-slider__overlay-{{ ai_gen_id }}"></div>

            <div class="ai-hero-video-slider__content-{{ ai_gen_id }}">
              {% if heading != blank %}
                <h2 class="ai-hero-video-slider__heading-{{ ai_gen_id }}">{{ heading }}</h2>
              {% endif %}

              {% if subheading != blank %}
                <p class="ai-hero-video-slider__subheading-{{ ai_gen_id }}">{{ subheading }}</p>
              {% endif %}

              {% if button_text != blank %}
                <a
                  href="{{ button_link }}"
                  class="ai-hero-video-slider__button-{{ ai_gen_id }}"
                >
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}

      {% if total_slides > 1 %}
        <button
          class="ai-hero-video-slider__navigation-{{ ai_gen_id }} ai-hero-video-slider__navigation--prev-{{ ai_gen_id }}"
          aria-label="Previous slide"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          class="ai-hero-video-slider__navigation-{{ ai_gen_id }} ai-hero-video-slider__navigation--next-{{ ai_gen_id }}"
          aria-label="Next slide"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="ai-hero-video-slider__dots-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign enabled_key = 'slide_' | append: i | append: '_enabled'
              assign is_enabled = block.settings[enabled_key]
            %}
            {% if is_enabled %}
              <button
                class="ai-hero-video-slider__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
                data-slide-index="{{ forloop.index }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</hero-video-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroVideoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
        this.videos = [];
        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.transitionDuration = parseFloat(this.dataset.transitionDuration) * 1000;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-hero-video-slider__slide-{{ ai_gen_id }}'));
        this.videos = Array.from(this.querySelectorAll('.ai-hero-video-slider__video-{{ ai_gen_id }}'));
        this.dots = Array.from(this.querySelectorAll('.ai-hero-video-slider__dot-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-hero-video-slider__navigation--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-hero-video-slider__navigation--next-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.setupEventListeners();
        this.setupVideoListeners();
        this.handleResponsiveVideos();
        window.addEventListener('resize', () => this.handleResponsiveVideos());
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });
      }

      setupVideoListeners() {
        this.videos.forEach((video, index) => {
          video.addEventListener('ended', () => {
            if (this.autoplayEnabled && this.isCurrentSlideVideo(video)) {
              this.nextSlide();
            }
          });
        });
      }

      isCurrentSlideVideo(video) {
        const currentSlideElement = this.slides[this.currentSlide];
        return currentSlideElement && currentSlideElement.contains(video);
      }

      handleResponsiveVideos() {
        const isMobile = window.innerWidth <= 749;
        this.videos.forEach(video => {
          const videoType = video.dataset.videoType;
          if (videoType === 'mobile') {
            video.style.display = isMobile ? 'block' : 'none';
          } else if (videoType === 'desktop') {
            video.style.display = isMobile ? 'none' : 'block';
          }
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        this.dots[this.currentSlide]?.classList.remove('active');
        this.pauseCurrentVideo();

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        this.dots[this.currentSlide]?.classList.add('active');
        this.playCurrentVideo();
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      playCurrentVideo() {
        const currentSlideElement = this.slides[this.currentSlide];
        const videos = currentSlideElement.querySelectorAll('.ai-hero-video-slider__video-{{ ai_gen_id }}');
        videos.forEach(video => {
          if (video.style.display !== 'none') {
            video.currentTime = 0;
            video.play().catch(() => {});
          }
        });
      }

      pauseCurrentVideo() {
        const currentSlideElement = this.slides[this.currentSlide];
        const videos = currentSlideElement.querySelectorAll('.ai-hero-video-slider__video-{{ ai_gen_id }}');
        videos.forEach(video => {
          video.pause();
        });
      }
    }

    customElements.define('hero-video-slider-{{ ai_gen_id }}', HeroVideoSlider{{ ai_gen_id }});
  })();
</script>

<style>
  @media screen and (max-width: 749px) {
    .ai-hero-video-slider__video--desktop-{{ ai_gen_id }} {
      display: none;
    }
    .ai-hero-video-slider__video--mobile-{{ ai_gen_id }} {
      display: block !important;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-hero-video-slider__video--mobile-{{ ai_gen_id }} {
      display: none !important;
    }
    .ai-hero-video-slider__video--desktop-{{ ai_gen_id }} {
      display: block;
    }
  }
</style>

